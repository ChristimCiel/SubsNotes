# Optional settings only. The sample/demo need no API key.
# This file is documentation, not automatically loaded configuration.
# Export settings, or use Node's --env-file flag when launching directly.
PORT=4183

# Optional MCP reader: select an absolute private directory OUTSIDE the repo.
# Never put real messages or credentials in examples or public Issues.
RENEW_BEFORE_DATA_DIR=/absolute/path/to/your/private/subscription-evidence

# Optional macOS build, without a developer account.
RENEW_SIGNING=adhoc
